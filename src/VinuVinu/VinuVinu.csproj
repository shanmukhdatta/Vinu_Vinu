<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>

		<Version>0.2.0</Version>
		<AssemblyVersion>0.2.0.0</AssemblyVersion>
		<FileVersion>0.2.0.0</FileVersion>

		<ApplicationIcon>logo.ico</ApplicationIcon>
		<PublishSingleFile>true</PublishSingleFile>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<ReadyToRun>false</ReadyToRun>
		<IncludeSymbols>false</IncludeSymbols>
	<AssemblyName>VinuVinu</AssemblyName>
    <Authors>Vinu Vinu contributors</Authors>
    <Description>Open-source multi-device audio sharing for Windows</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/shanmukhdatta/Vinu_Vinu</RepositoryUrl>
  </PropertyGroup>

	<ItemGroup>
		<None Remove="logo.png" />
		<None Remove="logo.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
		<PackageReference Include="NAudio" Version="2.3.0" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="logo.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="logo.ico" />

	</ItemGroup>

</Project>